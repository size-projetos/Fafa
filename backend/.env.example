# ---------------------------------------------------------------------------
# Fafa - variaveis de ambiente
# Copie para .env e preencha. O .env nunca vai para o repositorio.
# ---------------------------------------------------------------------------

# Cerebro (obrigatorio)
ANTHROPIC_API_KEY=sk-ant-...
FAFA_MODEL=claude-sonnet-4-5
FAFA_MAX_TOKENS=4096

# Identidade e comportamento
FAFA_NOME=Fafa
FAFA_DONO=Daniel Broleis
FAFA_EMPRESA=SIZE Engenharia Ambiental

# Persistencia
FAFA_DB_PATH=data/fafa.db

# Padroes tecnicos (SIZE)
FAFA_EPSG_PROJETADO=31982
FAFA_EPSG_GEOGRAFICO=4674

# Canal: Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=

# Canal: WhatsApp (Meta Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ALLOWED_NUMBERS=

# Canal: Web
FAFA_WEB_HOST=127.0.0.1
FAFA_WEB_PORT=8000
FAFA_WEB_TOKEN=

# Voz (opcional). TTS: auto | elevenlabs | openai | windows | mudo. STT: auto | openai | texto.
# 'auto' escolhe ElevenLabs > OpenAI > Windows conforme as chaves preenchidas.
FAFA_TTS=auto
FAFA_STT=auto

# ElevenLabs (melhor qualidade em pt-BR). Voice ID: pegue em elevenlabs.io > Voices.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# OpenAI: usado para transcrever a fala (STT) e, se nao houver ElevenLabs, para falar (TTS).
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
